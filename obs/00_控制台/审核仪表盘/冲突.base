filters:
  and:
    - 'file.ext == "md"'
    - '!file.inFolder("80_模板")'
    - 'flags.contains("conflicted")'
properties:
  file.name:
    displayName: 条目
  type:
    displayName: 类型
  maturity:
    displayName: 成熟度
  review_status:
    displayName: 审核状态
  scope:
    displayName: 适用范围
  status_reason:
    displayName: 冲突说明
  decision_ref:
    displayName: 裁决记录
  review_owner:
    displayName: 责任人
views:
  - type: table
    name: 冲突
    order:
      - file.name
      - type
      - maturity
      - review_status
      - scope
      - status_reason
      - decision_ref
      - review_owner

